{
  "name": "wordflow",
  "version": "0.1.0",
  "description": "Hands-free vocabulary review from any dictionary.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:pdf": "esbuild fixtures/check.ts --bundle --platform=node --format=esm --packages=external --outfile=fixtures/.check.mjs && node fixtures/.check.mjs",
    "check:ocr": "esbuild fixtures/ocr-check.ts --bundle --platform=node --format=esm --packages=external --outfile=fixtures/.ocr-check.mjs && node fixtures/.ocr-check.mjs",
    "fixtures": "python fixtures/make_fixtures.py",
    "check:parts": "esbuild fixtures/morphology-check.ts --bundle --platform=node --format=esm --packages=external --outfile=fixtures/.morph.mjs && node fixtures/.morph.mjs"
  },
  "type": "module",
  "dependencies": {
    "dexie": "^4.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "private": true
}
